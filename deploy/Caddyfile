# Install this site block in the shared host Caddy configuration. The staging
# Compose project deliberately exposes only a loopback-bound application port.
geolearn.43-156-101-13.sslip.io {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3101

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}
