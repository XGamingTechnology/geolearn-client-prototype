# Shared-host Caddy site blocks for GeoThink staging.
# Keep the legacy sslip.io hostname alive during DNS/TLS transition.
geothink.pro {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3101

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

www.geothink.pro {
  redir https://geothink.pro{uri} permanent
}

geolearn.43-156-101-13.sslip.io {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3101

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}
